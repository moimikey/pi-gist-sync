{
  "name": "pi-gist-sync",
  "version": "0.1.0",
  "description": "Pi extension that syncs your Pi agent config (settings, extensions, skills, prompts, themes) through a multi-file GitHub Gist.",
  "keywords": ["pi-package", "pi-extension", "pi", "gist", "sync", "settings", "backup"],
  "license": "MIT",
  "author": "Michael Hertzberg <mshertzberg@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/moimikey/pi-gist-sync.git" },
  "homepage": "https://github.com/moimikey/pi-gist-sync#readme",
  "bugs": { "url": "https://github.com/moimikey/pi-gist-sync/issues" },
  "type": "module",
  "files": ["extensions", "src", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "pi": { "extensions": ["./extensions/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
